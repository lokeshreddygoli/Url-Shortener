# =============================================================================
# Shortly Environment Configuration
# Copy this file to .env and fill in real values for local or prod environments.
# =============================================================================

# --- Application ---
NODE_ENV=development
APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# --- Database (PostgreSQL) ---
# Used by Prisma ORM and runtime queries
DATABASE_URL="postgresql://shortly:shortly_dev_password@localhost:5432/shortly?schema=public"
# Separate database for integration tests so test runs never touch dev data
TEST_DATABASE_URL="postgresql://shortly:shortly_dev_password@localhost:5432/shortly_test?schema=public"

# --- Redis (Cache, Rate Limiting, Analytics Queue) ---
# Leave unset or unreachable to verify graceful fallback mode
REDIS_URL="redis://localhost:6379"

# --- Security & Auth ---
# Minimum 32 characters; generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-secure-random-secret-at-least-32-chars"
# Used to sign guest link claim tokens and HMAC visitor hashes
ANALYTICS_HASH_SECRET="replace-with-another-secure-random-secret-32-chars"
GUEST_CLAIM_SECRET="replace-with-a-guest-claim-signing-secret-32-chars"

# --- Optional OAuth (Google) ---
# Leave empty to disable Google OAuth button gracefully
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Optional Email Transport (Password Reset) ---
# "console" logs reset links in dev; "smtp" uses SMTP_* settings
EMAIL_PROVIDER="console"
EMAIL_FROM="Shortly <no-reply@shortly.local>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""

# --- Optional Safety Scanning ---
# If set, checks destinations against Google Safe Browsing v4 API
GOOGLE_SAFE_BROWSING_API_KEY=""

# --- Rate Limiting & Link Defaults ---
GUEST_LINK_EXPIRY_DAYS="30"
LOG_LEVEL="info"
